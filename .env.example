# Copie ce fichier en ".env" (sans ".example") et adapte les valeurs.
# Le fichier ".env" lui-même ne doit JAMAIS être envoyé sur GitHub
# (il est déjà exclu dans .gitignore) : il contient des secrets.

# Laisse vide ou commente cette ligne pour utiliser la clé de secours
# intégrée au code (acceptable UNIQUEMENT en développement local) :
SECRET_KEY=

# True pour voir les pages d'erreur détaillées de Django en local.
# Doit TOUJOURS rester à False une fois déployé.
DEBUG=True

ALLOWED_HOSTS=127.0.0.1,localhost

# Laisse vide pour utiliser SQLite en local (aucune configuration
# nécessaire). Renseigne cette variable uniquement si tu veux tester
# avec une vraie base PostgreSQL avant de déployer.
DATABASE_URL=

# Laisse ces 4 lignes vides en local : les e-mails s'afficheront
# simplement dans le terminal (backend "console"). Remplis-les
# uniquement une fois que tu as créé un compte Brevo (ou un autre
# fournisseur SMTP) pour la version déployée.
EMAIL_HOST=
EMAIL_PORT=587
EMAIL_HOST_USER=
EMAIL_HOST_PASSWORD=
